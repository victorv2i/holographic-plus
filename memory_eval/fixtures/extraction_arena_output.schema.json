{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enfold.local/schemas/extraction-arena-output-v1.json",
  "title": "Normalized saved output for Enfold's offline extraction Arena",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "decision",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "enfold-extraction-arena-output-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "add",
        "dedup",
        "supersede",
        "conflict",
        "reject",
        "abstain"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "state": {
      "type": [
        "object",
        "null"
      ],
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "state",
            "preference",
            "commitment",
            "event"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "string",
          "minLength": 1
        },
        "negation": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "category",
        "sensitivity"
      ],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "sensitivity": {
          "enum": [
            "normal",
            "sensitive"
          ]
        },
        "evidence_span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          }
        },
        "evidence_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "expectation_key": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      }
    }
  }
}
