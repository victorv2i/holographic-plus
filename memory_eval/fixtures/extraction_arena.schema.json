{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enfold.local/schemas/extraction-arena-case-v1.json",
  "title": "Enfold offline extraction Arena case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "transcript",
    "expected_decision",
    "required_facts",
    "forbidden_facts"
  ],
  "properties": {
    "schema_version": {
      "const": "enfold-extraction-arena-case-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "transcript": {
      "type": "string",
      "minLength": 1
    },
    "expected_decision": {
      "$ref": "#/$defs/decision"
    },
    "required_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requiredFact"
      }
    },
    "forbidden_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenFact"
      }
    },
    "memory_before": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/priorFact"
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "$defs": {
    "decision": {
      "enum": [
        "add",
        "dedup",
        "supersede",
        "conflict",
        "reject",
        "abstain"
      ]
    },
    "sensitivity": {
      "enum": [
        "normal",
        "sensitive"
      ]
    },
    "state": {
      "type": [
        "object",
        "null"
      ],
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "state",
            "preference",
            "commitment",
            "event"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "string",
          "minLength": 1
        },
        "negation": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "requiredFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "content_patterns",
        "evidence",
        "categories",
        "sensitivity",
        "state"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "content_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "forbiddenFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "content_patterns"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "content_patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "priorFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "content",
        "category",
        "sensitivity",
        "state"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "sensitivity": {
          "$ref": "#/$defs/sensitivity"
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      }
    }
  }
}
